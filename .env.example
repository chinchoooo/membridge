# Copy to .env (git-ignored). Every value is optional.
MEMBRIDGE_DATA_DIR=~/.membridge
MEMBRIDGE_FALKOR_HOST=127.0.0.1
MEMBRIDGE_FALKOR_PORT=6390
MEMBRIDGE_FALKOR_GRAPH=membridge

# LLM tier is optional. none = rules only (default) | ollama (local) | openai_compat or claude_cli (hosted, need ALLOW_HOSTED)
MEMBRIDGE_LLM_PROVIDER=none
MEMBRIDGE_LLM_MODEL=phi3
MEMBRIDGE_LLM_BASE_URL=http://127.0.0.1:11434
# NAME of the environment variable that holds an API key (never put the key in this file)
MEMBRIDGE_LLM_API_KEY_ENV=MEMBRIDGE_LLM_API_KEY
MEMBRIDGE_ALLOW_HOSTED=false
MEMBRIDGE_REDACT_HOSTED=true

# Optional semantic channel: none | fastembed (needs `uv sync --extra embeddings`) | hashing
MEMBRIDGE_EMBEDDER=none

# MCP: identity shown in the audit log, and the bearer token for the loopback HTTP transport (>=16 chars)
MEMBRIDGE_CLIENT_NAME=mcp
# MEMBRIDGE_MCP_TOKEN=
